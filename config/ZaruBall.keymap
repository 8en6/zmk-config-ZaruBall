//&mt {
//    tapping-term-ms = <400>; // デフォルトは200msです。この数値を大きくするとHold判定が長くなります
//};

// -------------------------------------------------------------------------
// JIS変換定義 (OSが日本語配列設定の場合の出力マッピング)
// -------------------------------------------------------------------------
#define JP_AT           LBKT             // @ (USの [ キー)
#define JP_CARET        EQUAL            // ^ (USの = キー)
#define JP_YEN          INT3             // ¥ (JISの ¥ キー)
#define JP_PIPE         LS(INT3)         // | (Shift + ¥)
#define JP_COLON        SQT              // : (USの ' キー)
#define JP_LBRACKET     RBKT             // [ (USの ] キー)
#define JP_RBRACKET     NUHS             // ] (USの \ キー / Non-US #)
#define JP_UNDERSCORE   LS(INT1)         // _ (Shift + Ro)
#define JP_BACKSLASH    INT1             // \ (Roキー)

// Shiftが必要な記号
#define JP_DQUOTE       LS(N2)           // "
#define JP_AMPERSAND    LS(N6)           // &
#define JP_QUOTE        LS(N7)           // '
#define JP_LPAREN       LS(N8)           // (
#define JP_RPAREN       LS(N9)           // )
#define JP_EQUAL        LS(MINUS)        // =
#define JP_PLUS         LS(SEMI)         // +
#define JP_ASTERISK     LS(SQT)          // *
#define JP_TILD         LS(EQUAL)        // ~
#define JP_GRAVE        LS(LBKT)         // `
#define JP_LBRACE       LS(RBKT)         // {
#define JP_RBRACE       LS(NUHS)         // }

// -------------------------------------------------------------------------
// レイヤー定義
// -------------------------------------------------------------------------
#define BASE     0
#define NAGINATA 1
#define MOUSE    2
#define LOWER    3
#define RAISE    4
#define ADJUST   5
#define MOD      6
#define SCROLL   3
#define FUNCTION 7

// スクロール量の設定
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                        &zip_xy_scaler 2 3>;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            //&zip_xy_transform INPUT_TRANSFORM_Y_INVERT
                            &zip_xy_scaler 1 40
                            &zip_xy_to_scroll_mapper
                            >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

//        tri_layer {
//            if-layers = <3 4>;
//            then-layer = <5>;
//        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定
        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        battery_type: battery_type {
        compatible = "zmk,behavior-battery-type";
        #binding-cells = <0>;
        };
        
        // 高速タイピング用のMod-Tap設定（Home Row Mods用）
        mt_tap: mod_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";      // ★重要：他のキーと重なってもTap（文字）を優先する
            tapping-term-ms = <200>;       // 長押しの判定時間（好みで調整）
            quick-tap-ms = <150>;          // 連続タップで文字をリピートさせる
            require-prior-idle-ms = <125>; // ★超重要：直前に別のキーを打っていたら、強制的にTapにする
            bindings = <&kp>, <&kp>;
        };
        
        // KとL専用の遅いLayer-Tap
        lt_slow: layer_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred"; // 短く押した時は確実にキー入力を優先
            tapping-term-ms = <250>;  // ★ここを好みの長さに設定（デフォルトは200）
            quick-tap-ms = <200>;     // 連続タップ時のレイヤー暴発防止
            require-prior-idle-ms = <125>; // ★これを追加：直前に別のキー入力があれば絶対にTap(文字)にする
            bindings = <&mo>, <&kp>;  // 長押しでレイヤー(&mo)、短押しでキー(&kp)
            
            display-name = "Layer Tap Slow";
        };

        // ダブルタップ＆ホールドで連続バックスペースになるLayer-Tap
        lt_bspc: layer_tap_backspace {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>; // 通常の長押し（Hold）判定時間
            quick-tap-ms = <200>;    // ★ここがダブルタップリピートの受付時間です
            bindings = <&mo>, <&kp>; // ※もしMod-Tapとして使う場合は <&kp>, <&kp> にしてください
        };

        // Customed Hold-Tap for SandS
        // 他キーとの同時押しのみHold(Shift), 500m以上長押しすると、Tap(Space)のリピート
        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>; // tap-unless-interruptedのため意味は無いが、設定しないとエラーはく
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        ht_BASE: ht_BASE {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&BL_mod>, <&kp>;

            display-name = "ht-BL_mod";
        };
        // ▼▼▼ ここから追加 ▼▼▼
        rot_zoom: sensor_rotate_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&zoom_in>, <&zoom_out>;
            tap-ms = <20>;
        };
        // ▲▲▲ ここまで追加 ▲▲▲
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer)
        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };

        // Support swapping into Scroll layer when AML is activated

        to_scroll_layer: to_scroll_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to SCROLL>,
                <&macro_press>,
                <&mo SCROLL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo SCROLL>;
        };

        BL_mod: BL_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo MOD &macro_param_1to1>,
                <&macro_press>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&mo MOD>;
        };

        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANG1 &to NAGINATA>;
        };
   
        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANG2 &to BASE>;
        };

        // ▼▼▼ ここから追加 ▼▼▼
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc SCRL_UP>
                , <&macro_release &kp LCTRL>;
        };

        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &msc SCRL_DOWN>
                , <&macro_release &kp LCTRL>;
        };
        // ▲▲▲ ここまで追加 ▲▲▲
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&lt ADJUST ESC    &kp N1  &kp N2      &kp N3    &kp N4     &kp N5                         &kp N1            &kp N2   &kp N3   &kp BSPC                       &kp N6        &kp N7  &kp N8            &kp N9       &kp N0    &kp MINUS
&kp TAB    &lt_slow RAISE Q  &kp W       &kp E     &kp R      &kp T                           &kp N4            &kp N5   &kp N6   &kp JP_PLUS                    &kp Y         &kp U   &kp I             &kp O        &kp P     &kp JP_AT
&kp LALT   &mt_tap LALT A    &kp S       &kp D     &kp F      &kp G      &kp LG(D)        &kp N7            &kp N8   &kp N9   &kp MINUS    &kp JP_YEN        &kp H         &kp J   &lt_slow LOWER K  &lt_slow RAISE L  &mt_tap LALT SEMI  &kp JP_COLON
&kp LSHFT  &mt_tap LSHFT Z   &kp X       &kp C     &kp V      &kp B      &kp JP_LBRACKET  &lt ADJUST ESC    &kp N0   &kp DOT  &kp RET      &kp JP_RBRACKET   &kp N         &kp M   &kp COMMA         &kp DOT      &mt_tap LSHFT FSLH  &kp 0x87
&kp LCTRL  &kp LG(L)  &kp LWIN  &lt NAGINATA INT5  &lt RAISE SPACE  &lt LOWER INT4                                                        &lt_bspc FUNCTION BSPC  &lt MOUSE RET                                            &kp JP_CARET
            >;
        };

        naginata_layer {
            display-name = "Naginata";
            // ▼ 修正: 作成した rot_zoom を割り当て
            sensor-bindings = <&rot_zoom>;
            bindings = <
&trans     &kp F1     &kp F2               &kp F3            &kp F4              &kp F5                      &kp LS(N8) &kp UP   &kp LS(N9) &kp DEL                     &kp F6          &kp F7           &kp F8            &kp F9         &kp F10     &kp F11
&kp TAB    &none      &none                &kp LC(LS(UP))    &kp PG_UP           &none                       &kp LEFT   &kp DOWN &kp RIGHT  &kp LS(JP_COLON)            &none           &kp LS(UP)       &kp UP            &none          &kp LALT    &none
&kp LALT   &kp LALT   &kp LC(LS(LEFT))     &kp LC(LS(DOWN))  &kp LC(LS(RIGHT))   &kp HOME &kp LG(LS(C))      &trans     &kp F2   &trans     &kp FSLH          &none     &kp HOME        &kp LEFT         &kp DOWN          &kp RIGHT      &kp LSHFT   &none
&kp LSHFT  &kp LSHFT  &kp LA(PG_UP)        &kp PG_DN         &kp LA(PG_DN)       &kp END  &none              &trans     &kp N0   &kp DOT    &kp TAB           &none     &kp END         &kp LS(LEFT)     &kp LS(DOWN)      &kp LS(RIGHT)  &none       &none
&kp LCTRL           &none  &kp LWIN    &trans     &trans    &trans                                                                                            &trans   &kp LA(ENTER)                                                         &none
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&rot_zoom>;
            bindings = <
&trans     &kp N1       &kp N2      &kp N3           &kp N4           &kp N5                      &trans &trans &trans &trans             &kp F6          &kp F7           &kp F8            &kp F9         &kp F10     &kp F11
&kp TAB    &kp N1       &kp N2      &kp N3           &kp N4           &kp N5                       &trans &trans &trans &trans             &none           &kp LS(UP)       &kp UP            &none          &kp LALT    &none
&kp LALT   &kp N6       &kp N7      &kp N8           &kp N9           &kp N0   &kp LG(LS(C))      &trans &trans &trans &trans   &none     &kp HOME        &kp LEFT         &kp DOWN          &kp RIGHT      &kp LSHFT   &none
&kp LSHFT  &kp LS(SEMI) &kp MINUS   &kp LS(JP_COLON) &kp FSLH         &kp DOT  &none              &trans &trans &trans &trans   &none     &kp END         &kp LS(LEFT)     &kp LS(DOWN)      &kp LS(RIGHT)  &none       &none
&kp LCTRL           &none  &kp LWIN    &kp TAB     &kp RET    &kp BSPC                                                                        &trans   &kp LA(ENTER)                                                         &none
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans     &kp LS(N1)    &kp LS(N2)    &kp LS(N3)    &kp LS(N4)      &kp LS(N5)                           &trans &trans &trans &trans                       &kp LS(N6)   &kp LS(N7)   &kp LS(N8)       &kp LS(N9)  &kp LS(N0)    &kp LS(MINUS)
&kp TAB    &kp LS(N7)    &kp LS(N2)    &kp LS(MINUS) &none           &kp LS(SEMI)                         &trans &trans &trans &trans                       &kp JP_YEN   &kp LS(0x87) &kp LS(N8)       &kp LS(N9)  &kp LS(N5)    &kp LS(JP_AT)
&kp LALT   &kp JP_AT     &kp SEMI      &kp LS(N4)    &kp JP_LBRACKET &kp JP_RBRACKET &kp LG(LS(S))        &trans &trans &trans &trans   &kp LS(JP_YEN)      &kp LS(N3)   &mkp LCLK    &kp LS(JP_COLON) &mkp RCLK   &kp LS(SEMI)  &kp LS(JP_COLON)
&kp LSHFT  &none         &none         &kp JP_COLON  &none           &kp LS(N1)      &kp LS(JP_LBRACKET)  &trans &trans &trans &trans   &kp LS(JP_RBRACKET) &kp LS(N6)   &kp MINUS    &kp LS(COMMA)    &kp LS(DOT) &kp LS(FSLH)  &kp LS(0x87)
&kp LCTRL                &kp C_MUTE    &trans        &trans        &trans        &trans                                 &trans   &kp LC(ENTER)                                     &kp LS(JP_CARET)
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans    &kp F1     &kp F2         &kp F3         &kp F4         &kp F5                    &trans &trans &trans &trans              &kp F6     &kp F7      &kp F8       &kp F9     &kp F10    &kp F11
&kp TAB   &none      &kp TAB        &kp LC(UP)     &kp LG(UP)     &none                     &trans &trans &trans &trans              &none     &none     &none     &none     &none   &none
&kp LALT  &kp LALT   &kp LC(LEFT)   &kp LC(DOWN)   &kp LC(RIGHT)  &none    &kp LG(LC(T))    &trans &trans &trans &trans   &kp LC(X)  &kp LC(C)  &mkp LCLK  &mkp RCLK   &mkp RCLK    &kp LALT      &none
&kp LSHFT &kp LSHFT  &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &none    &none            &trans &trans &trans &trans   &kp LG(V)  &kp LC(V)  &kp LC(Z)  &kp LC(Y)   &none        &kp LSHFT      &none
&kp LCTRL         &none  &trans     &trans     &trans          &trans                                          &kp DEL     &kp LS(ENTER)                                         &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            // 時計回り: 拡大 (Ctrl + テンキーの+)
            // 反時計回り: 縮小 (Ctrl + テンキーの-)
            sensor-bindings = <&inc_dec_kp LC(KP_PLUS) LC(KP_MINUS)>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                   &kp LS(N8) &kp UP   &kp LS(N9) &kp DEL                     &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&kp TAB    &none      &none         &none         &none         &none                          &kp LEFT   &kp DOWN &kp RIGHT  &kp LS(JP_COLON)            &bt BT_CLR      &none  &none  &none  &none  &none
&kp LALT   &none      &none         &none         &none         &none          &battery_type   &kp LC(C)  &kp F2   &kp LC(V)  &kp FSLH           &ind_bat &out OUT_TOG    &none  &none  &none  &none  &none
&kp LSHFT  &none      &none         &none         &none         &none          &none           &none      &kp N0   &kp DOT    &kp TAB            &ind_con &studio_unlock  &none  &none  &none  &none  &none
&kp LCTRL           &none  &kp LWIN    &trans     &trans    &trans                                                                               &trans   &battery_type                               &none
            >;
        };

        mod_layer {
            display-name = "Mod";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3  &kp N4  &kp N5           &trans &trans &trans &trans             &kp N6    &kp N7  &kp N8  &kp N9     &kp N0   &kp MINUS
&kp TAB    &kp F1  &kp F2    &kp F3  &kp F4  &kp F5           &trans &trans &trans &trans             &kp Y     &kp U   &kp I   &kp O      &kp P    &kp EQUAL
&kp LALT   &kp F6  &kp F7    &kp F8  &kp F9  &kp F10          &trans &trans &trans &trans  &kp INS    &kp LBKT  &kp H   &kp J   &kp K      &kp L    &kp LALT   &kp SQT
&kp LSHFT  &kp F11 &kp F12   &kp C   &kp V   &kp B            &trans &trans &trans &trans  &kp GRAVE  &kp RBKT  &kp N   &kp M   &kp COMMA  &kp DOT  &kp LSHFT   &lt SCROLL BACKSLASH
&kp LCTRL             &none  &kp LWIN    &kp TAB     &kp RET    &kp BSPC                                      &trans    &trans                              &trans
            >;
        };

        fuction_layer {
            display-name = "Funcion";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3  &kp N4  &kp N5           &trans &trans &trans &trans             &kp N6    &kp N7  &kp N8  &kp N9     &kp N0   &kp MINUS
&kp TAB    &kp F1  &kp F2    &kp F3  &kp F4  &kp F5           &trans &trans &trans &trans             &kp Y     &kp U   &kp I   &kp O      &kp P    &kp EQUAL
&kp LALT   &kp F6  &kp F7    &kp F8  &kp F9  &kp F10          &trans &trans &trans &trans  &kp INS    &kp LBKT  &kp H   &kp J   &kp K      &kp L    &kp LALT   &kp SQT
&kp LSHFT  &kp F11 &kp F12   &kp C   &kp V   &kp B            &trans &trans &trans &trans  &kp GRAVE  &kp RBKT  &kp N   &kp M   &kp COMMA  &kp DOT  &kp LSHFT   &lt SCROLL BACKSLASH
&kp LCTRL             &none  &kp LWIN    &kp TAB     &kp RET    &kp BSPC                                      &trans    &trans                              &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
